# CloudSpring n8n -- host config. NOT in the repo. Secrets go here only.
# Template: automation/n8n/host/.env.example in cldsprng/cloudspring-mockups

# --- listener -------------------------------------------------------------
# Bound to loopback on purpose. Nothing about this box should be internet
# facing; the demo surface is exposed on demand via cloudflared (see README).
N8N_LISTEN_ADDRESS=127.0.0.1
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://127.0.0.1:5678
# N8N_WEBHOOK_URL replaces the deprecated WEBHOOK_URL (n8n 2.x warns on the old
# name). Sets the base URL for both test and production webhooks.
N8N_WEBHOOK_URL=http://127.0.0.1:5678/

# --- runtime --------------------------------------------------------------
GENERIC_TIMEZONE=Asia/Manila
TZ=Asia/Manila
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
# N8N_RUNNERS_ENABLED was removed in n8n 2.x -- task runners are always on, and
# setting it only produces a deprecation warning. Left out on purpose.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# Code nodes read STL_* and GHL_* from this file, so env access must stay on.
N8N_RUNNERS_TASK_TIMEOUT=300
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=false
DB_SQLITE_POOL_SIZE=1
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336

# --- logging --------------------------------------------------------------
# n8n defaults to console-only. Without these there is NO log file at all:
# piping the console through Tee-Object does not work for a long-running native
# process on Windows (PowerShell block-buffers it and never flushes). Let n8n
# write and rotate the file itself.
N8N_LOG_OUTPUT=console,file
N8N_LOG_LEVEL=info
N8N_LOG_FILE_LOCATION=C:\Users\ACenteno\cloudspring-n8n\logs\n8n.log
N8N_LOG_FILE_SIZE_MAX=16
N8N_LOG_FILE_COUNT_MAX=10

# --- Speed-to-Lead engine -------------------------------------------------
# HARD BOUNDARY: sandbox means no real SMS and no real email leaves this box.
# Do not change without the CEO signing off on a live client account.
STL_DELIVERY_MODE=sandbox
STL_BOOKING_URL=https://api.leadconnectorhq.com/widget/booking/QRPEnWRw2Kx9rBe0Mj6J

# --- GoHighLevel ----------------------------------------------------------
# The GHL API is WORKING. Re-confirmed live 2026-08-19: get-pipelines returned
# 200 with all three pipelines on location AtaR2iB3BL1hlhP4oU26.
# Do NOT health-check with list_locations -- it is broken for single-location
# connections and its "dependencies are not configured" reply means nothing.
# Health-check with get-pipelines instead.
#
# Still empty for a different reason: no SANDBOX sub-account exists yet. The
# connection is bound to CloudSpring IT Solutions itself, which holds live
# client pipelines and two published workflows -- writing demo contacts there
# could fire real outbound. Leave empty until a sandbox sub-account is created;
# the moment its id lands here the "GHL Configured" branch flips live.
GHL_SANDBOX_LOCATION_ID=
