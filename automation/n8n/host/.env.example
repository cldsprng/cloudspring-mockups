# CloudSpring n8n -- host config. NOT in the repo. Secrets go here only.
# Template: automation/n8n/host/.env.example in cldsprng/cloudspring-mockups

# --- listener -------------------------------------------------------------
# Bound to loopback on purpose. Nothing about this box should be internet
# facing; the demo surface is exposed on demand via cloudflared (see README).
N8N_LISTEN_ADDRESS=127.0.0.1
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://127.0.0.1:5678
WEBHOOK_URL=http://127.0.0.1:5678/

# --- runtime --------------------------------------------------------------
GENERIC_TIMEZONE=Asia/Manila
TZ=Asia/Manila
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_RUNNERS_ENABLED=true
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=false
DB_SQLITE_POOL_SIZE=1
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336

# --- Speed-to-Lead engine -------------------------------------------------
# HARD BOUNDARY: sandbox means no real SMS and no real email leaves this box.
# Do not change without the CEO signing off on a live client account.
STL_DELIVERY_MODE=sandbox
STL_BOOKING_URL=https://api.leadconnectorhq.com/widget/booking/QRPEnWRw2Kx9rBe0Mj6J

# Weekly owner report identity. FALLBACKS ONLY -- a real caller names the clinic
# and the week in the POST body, so one n8n instance can serve every client.
# Setting STL_CLINIC_NAME here pins this instance to one clinic; leave it unless
# you are demoing. STL_REPORT_WEEK_OF is normally derived from the data (the
# Monday on or before the earliest lead) and a static value here goes stale the
# following week -- leave it empty.
STL_CLINIC_NAME=
STL_REPORT_WEEK_OF=

# --- GoHighLevel ----------------------------------------------------------
# The GHL API is WORKING (confirmed 2026-08-19). The old "dependencies are not
# configured" reading came from list_locations, which is meaningless on a
# single-location connection -- health-check with get-pipelines instead.
#
# Still empty for a different reason: no SANDBOX sub-account exists yet. The
# connection is bound to CloudSpring IT Solutions itself, which holds live
# client pipelines and two published workflows -- writing demo contacts there
# could fire real outbound. Leave empty until a sandbox sub-account is created;
# the moment its id lands here the "GHL Configured" branch flips live.
GHL_SANDBOX_LOCATION_ID=

# The pipeline the upsert writes into. NO DEFAULT, deliberately. This used to be
# hardcoded to 7yd9fhvPcfz1vqbF3kxN -- the LIVE CLOUDSPRING WEB LEADS pipeline --
# which meant the moment GHL_SANDBOX_LOCATION_ID was filled in, demo contacts
# would have been aimed at a real pipeline in the production location. Put a
# sandbox pipeline id here or leave it empty; never a production one.
# speed-to-lead-smoke.mjs refuses to run if a live id is hardcoded in a workflow.
GHL_SANDBOX_PIPELINE_ID=
