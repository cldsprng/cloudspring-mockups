#!/bin/sh
# Brand gate — structural, not advisory.
#
# Every mockup folder touched by a push is verified against its captured
# brand.json before the push is allowed. Non-zero exit means no deploy, and
# Cloudflare Pages deploys from main, so no deploy means nothing reaches a
# prospect.
#
# There is no override. No --no-verify path is sanctioned, no environment
# variable disables this, and no "GENERIC BRANDING" flag buys an exception.
# That escape hatch is what let 18+ unbranded mockups ship.
#
# Installed by: node tools/hooks/install.mjs

set -u

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT" || exit 1

ZERO=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')

# A mockup folder is a top-level directory containing index.html — that is the
# deploy unit per PIPELINE-CONFIG.md ("One folder per mockup: /<slug>/index.html").
# tools/, automation/ and root files have no index.html, so they are never gated.
#
# Scoped to deploy artifacts: <slug>/brand/** is builder *input* — the captured
# logo and palette the rebuild reads from. It is not part of the rendered page,
# so adding it cannot make a deployed mockup worse. A push that only adds or
# updates <slug>/brand/** is therefore not gated; anything that changes
# <slug>/index.html or an asset it renders still is.
#
# This is a scoping correction, not an override. Without it the gate deadlocks:
# the rebuild cannot start without the captured brand data, and the brand data
# cannot land until the rebuild is done. It also made the no-assets records
# ("do not build this slug") permanently unlandable, so every run re-attempted
# the same dead captures. Approved on CLO-27.
changed_mockup_folders() {
  local_sha=$1
  remote_sha=$2

  if [ "$remote_sha" != "$ZERO" ]; then
    range="$remote_sha..$local_sha"
  else
    # New branch on the remote: gate only commits not already on some remote.
    first=$(git rev-list "$local_sha" --not --remotes | tail -n 1)
    [ -z "$first" ] && return 0
    if git rev-parse --verify --quiet "$first^" >/dev/null 2>&1; then
      range="$first^..$local_sha"
    else
      range="$local_sha"
    fi
  fi

  git diff --name-only "$range" -- 2>/dev/null \
    | grep '/' \
    | grep -v '^[^/]*/brand/' \
    | sed 's|/.*||' \
    | sort -u
}

failed=0
gated=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  # Branch deletion — nothing to verify.
  [ "$local_sha" = "$ZERO" ] && continue

  for folder in $(changed_mockup_folders "$local_sha" "$remote_sha"); do
    # Only gate folders that are a mockup in the commit being pushed.
    git cat-file -e "$local_sha:$folder/index.html" 2>/dev/null || continue

    gated=$((gated + 1))
    printf '\n[brand gate] %s\n' "$folder"

    # The gate reads the working tree, so the working tree has to be what is
    # being pushed. Uncommitted changes in a gated folder mean we cannot prove
    # what would deploy. That is a failure, not a warning.
    if [ -n "$(git status --porcelain -- "$folder")" ]; then
      echo "  FAIL  uncommitted changes in $folder — commit or stash them so the gate verifies what actually deploys"
      failed=$((failed + 1))
      continue
    fi

    if ! node tools/brand-capture/verify-brand.mjs "$folder"; then
      failed=$((failed + 1))
    fi
  done
done

if [ "$failed" -gt 0 ]; then
  cat <<EOF

================================================================
PUSH BLOCKED — $failed mockup folder(s) failed the brand gate.
================================================================
Fix the branding. Do not bypass this hook.

  - brand.json missing or ready:false  -> re-run capture:
      node tools/brand-capture/capture.mjs --site <domain> --slug <slug> --out <slug>/brand
  - blockedBy: palette-pending         -> vision-read the logo, write the hexes
                                          into colors.brand[], colors.source="vision"
  - blockedBy: no-assets               -> do NOT build. Move the card to BRAND BLOCKED.
  - invented palette (<2 hexes match)  -> rebuild using the captured hexes

There is no send-anyway path. A mockup that fails this gate does not ship.
EOF
  exit 1
fi

[ "$gated" -gt 0 ] && printf '\n[brand gate] %s mockup folder(s) passed.\n' "$gated"
exit 0
